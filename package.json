{
  "name": "villmond-prediction-markets-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, white-label, zero-knowledge prediction market framework (VILCOIN closed-loop economy)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "nostr",
    "contracts",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:bdd": "npm run build --workspaces --if-present && node --import tsx ./node_modules/.bin/cucumber-js",
    "lint": "npm run lint --workspaces --if-present && tsc -p features/tsconfig.json --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
