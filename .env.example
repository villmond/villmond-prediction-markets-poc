# Copy to .env and fill in real values. .env is gitignored — never commit it.
# scripts/deploy.sh auto-loads .env from the repo root if present. Variables
# already exported in your shell take precedence over .env's values.

# --- contracts/scripts/deploy-devnet.ts, scripts/deploy.sh --deploy-contracts ---
# base58 PrivateKey of a Mina Devnet account funded with test MINA.
# Leave unset to have deploy-devnet.ts generate + faucet-fund a fresh one.
DEVNET_DEPLOYER_KEY=

# base58 PublicKey (B62q...) for MarketSettlement's admin/oracle. Each
# defaults to the deployer's own key if left unset.
MARKET_ADMIN_PUBLIC_KEY=
MARKET_ORACLE_PUBLIC_KEY=

# --- scripts/deploy.sh --ipfs=remote ---
IPFS_API_URL=http://127.0.0.1:5001

# --- scripts/deploy.sh --host=preview ---
PREVIEW_PORT=4173

# --- scripts/deploy.sh --generate-config (scaffolds config.yaml) ---
APP_NAME=Villmond Markets
TOKEN_NAME=VILCOIN
INITIAL_USER_BALANCE=1000
ADMIN_FEE_PERCENTAGE=2.5
ADMIN_NOSTR_PUBKEY=npub1...
ENABLE_CASHIER_NETWORK=false
ESCROW_TIMEOUT_BLOCKS=150
MIN_CASHIER_STAKE=5000
ENABLE_PHYSICAL_P2P=true
MIN_REPUTATION_THRESHOLD=3.0
